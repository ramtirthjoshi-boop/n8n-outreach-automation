    {
      "parameters": {
        "jsCode": "// Get all incoming items\nconst items = $input.all();\n\nif (!items.length) {\n  return [];\n}\n\n// Find the latest item by createdAt\nlet latest = items[0];\n\nfor (const item of items) {\n  const currentDate = new Date(item.json.createdAt);\n  const latestDate = new Date(latest.json.createdAt);\n\n  if (currentDate > latestDate) {\n    latest = item;\n  }\n}\n\n// Output ONLY the count\nreturn [\n  {\n    json: {\n      count: latest.json.count\n    }\n  }\n];"
      },
