      "id": "ea7ff894-9a23-4c00-9f8a-0fd7393dfd45",
      "name": "Get a thread",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// thread object from Gmail → Thread → Get\nconst thread = items[0].json;\n\n// result meanings:\n// 1 = needs attention (a human reply, or a bounce) → alert branch\n// 2 = no reply\n// 3 = auto reply\n// 4 = the thread could not be read at all\nlet result = 2;\nlet issue = 'Replied';\nlet subject = 'Replied';\n\n// Gmail answers 403 Forbidden for a thread the connected account cannot see -\n// one sent from a different mailbox, or since deleted. That used to throw and\n// abort the whole run, so every row queued behind it stayed unchecked for good.\n// \"Get a thread\" now continues on error, which lands here as an error item.\n// Mark it once so the row stops being retried every two hours.\nif (!thread || thread.error !== undefined || (!thread.id && !Array.isArray(thread.messages))) {\n  return [{ json: { result: 4, issue: 'Thread unreadable', subject: 'Thread unreadable' } }];\n}\n\n// keywords that scream \"robot\"\nconst autoReplyKeywords = [\n  \"out of office\",\n  \"automatic reply\",\n  \"auto-reply\",\n  \"autoreply\",\n  \"away from the office\",\n  \"on vacation\",\n  \"on holiday\",\n  \"in holiday\",\n  \"i'm on holiday\",\n  \"i am on holiday\",\n  \"i'm in holiday\",\n  \"i am in holiday\",\n  \"ooo\"\n];\n\n// A bounce is not a reply. Mail servers announce themselves in the From line and\n// in the subject, and a delivery status report carries its own content type.\nconst BOUNCE_FROM = /mailer-daemon|postmaster@|mail delivery (subsystem|system)/i;\nconst BOUNCE_SUBJECT = /undeliverable|returned mail|delivery status notification \\(failure\\)|mail delivery failed|delivery (has )?failed|failure notice|address not found|recipient unknown|couldn't be delivered|wasn't found/i;\n\n// helper to read headers safely\nfunction getHeader(msg, name) {\n  const h = (msg.payload?.headers || [])\n    .find(h => h.name.toLowerCase() === name.toLowerCase());\n  return h?.value?.toLowerCase() || \"\";\n}\n\nconst msgs = thread.messages || [];\n\n// only your own message exists\nif (msgs.length <= 1) {\n  return [{ json: { result, issue, subject } }];\n}\n\nfor (let i = 1; i < msgs.length; i++) {\n  const msg = msgs[i];\n\n  const snippet = (msg.snippet || \"\").toLowerCase();\n  const labels = (msg.labels || []).map(l => l.id || l);\n\n  // if it's SENT, it's yours → skip\n  if (labels.includes(\"SENT\")) {\n    continue;\n  }\n\n  const from = getHeader(msg, \"From\");\n  const subjectHeader = getHeader(msg, \"Subject\");\n  const contentType = getHeader(msg, \"Content-Type\");\n  const failedRecipients = getHeader(msg, \"X-Failed-Recipients\");\n\n  // bounce check runs first: a daemon message would otherwise read as a human reply\n  const isBounce =\n    BOUNCE_FROM.test(from) ||\n    BOUNCE_SUBJECT.test(subjectHeader) ||\n    BOUNCE_SUBJECT.test(snippet) ||\n    contentType.includes(\"report-type=delivery-status\") ||\n    failedRecipients !== \"\";\n\n  if (isBounce) {\n    result = 1;\n    issue = 'Bounced';\n    subject = 'Bounced';\n    break;\n  }\n\n  // keyword-based auto reply detection\n  const isKeywordAutoReply = autoReplyKeywords.some(k =>\n    snippet.includes(k)\n  );\n\n  // header-based auto reply detection (the real signal)\n  const autoSubmitted = getHeader(msg, \"Auto-Submitted\");\n  const xAutoReply = getHeader(msg, \"X-Autoreply\");\n  const precedence = getHeader(msg, \"Precedence\");\n\n  const isHeaderAutoReply =\n    autoSubmitted.includes(\"auto\") ||\n    xAutoReply === \"yes\" ||\n    precedence === \"bulk\";\n\n  // optional short-text heuristic\n  const isVeryShort = snippet.split(\" \").length <= 6;\n\n  if (isHeaderAutoReply || isKeywordAutoReply || isVeryShort) {\n    result = 3; // auto reply\n    break;\n  }\n\n  // otherwise real human reply\n  result = 1;\n  issue = 'Replied';\n  subject = 'Replied';\n  break;\n}\n\nreturn [{ json: { result, issue, subject } }];\n"
      },
